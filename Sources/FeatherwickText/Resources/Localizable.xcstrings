            "value" : "I noticed your %1$@ at the %2$@. Third place. Well earned."
          }
        }
      }
    },
    "notes.dot.shutTheDoor" : {
      "comment" : "A note in the post from Dot.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A hint for show week: shut the coop at night. A fox fright still shows on the judging table."
          }
        }
      }
    },
    "notes.fineEggs" : {
      "comment" : "In Mr Okafor's note, when the Egg Book is empty: \"My window has fine eggs\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
