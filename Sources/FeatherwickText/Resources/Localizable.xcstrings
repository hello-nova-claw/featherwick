    },
    "notes.hazel.borrowed" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A borrowed bird is a guest. Treat a guest well, and the stories go home with them."
          }
        }
      }
    },
    "notes.hazel.broody" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If a hen sits tight and fluffs up at you, she's broody. She's the best incubator there is."
          }
        }
      }
    },
    "notes.hazel.coopDoor" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A shut door is a quiet night. An open one is a fed flock in the morning. Your choice, love."
          }
        }
      }
    },
    "notes.hazel.crosses" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A cross can be as fine a bird as any purebred. The pet class takes crosses, and judges them fairly."
          }
        }
      }
    },
    "notes.hazel.favouriteLook" : {
      "comment" : "A note in the post from Hazel. The placeholder is a look from the Breed Book, such as \"gold laced wyandotte\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I keep thinking about your %@. A lovely look."
          }
        }
      }
    },
    "notes.hazel.favouriteLook.general" : {
      "comment" : "A note in the post from Hazel, when what it names has gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I keep thinking about your flock. A lovely mix of looks."
          }
        }
      }
    },
    "notes.hazel.firstPeep" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every egg hatches if you give it time. I still go soft at the first peep."
          }
        }
      }
    },
    "notes.hazel.handling" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick them up while they're small, love. A chick learns trust faster than any grown bird."
          }
        }
      }
    },
    "notes.hazel.moult" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Feathers everywhere? That's the moult. They'll be in new clothes before winter."
          }
        }
      }
    },
    "notes.hazel.notes" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep notes on who you pair. A colour can hide for a generation and turn up later."
          }
        }
      }
    },
    "notes.hazel.oldHens" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Old hens stop laying in time. They still earn their keep: they keep the young ones in line."
          }
        }
      }
    },
    "notes.hazel.patience" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your birds come to the gate when you call. That's patience, that is."
          }
        }
      }
    },
    "notes.hazel.peckingOrder" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A word on the pecking order. Every flock sorts itself out. Give it a few days and all is calm."
          }
        }
      }
    },
    "notes.hazel.springAgain" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spring again. The best time to set eggs, my mother always said."
          }
        }
      }
    },
    "notes.hazel.winterLaying" : {
      "comment" : "A note in the post from Hazel.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hens lay less in the short days. Don't fret. They pick up again in spring."
          }
        }
      }
    },
