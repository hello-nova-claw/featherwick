    "notes.dot.firstEntry" : {
      "comment" : "A note in the post from Dot.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Thank you for bringing your birds to the show. Every keeper starts somewhere."
          }
        }
      }
    },
    "notes.dot.friendliness" : {
      "comment" : "A note in the post from Dot.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The pet class is half friendliness. A bird that sits still for me scores well."
          }
        }
      }
    },
    "notes.dot.harvest" : {
      "comment" : "A note in the post from Dot. The placeholder is the autumn show's name.",
