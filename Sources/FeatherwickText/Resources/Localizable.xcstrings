    "notes.okafor.blue" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A blue egg, I hear. There is a space in my window for one, if you ever have a spare."
          }
        }
      }
    },
    "notes.okafor.brown" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brown eggs, warm as toast. The colour is only on the outside, but I like it all the same."
          }
        }
      }
    },
    "notes.okafor.chocolate" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A chocolate egg, dark as a crust. I would like to bake with one, one day."
          }
        }
      }
    },
    "notes.okafor.cream" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cream eggs, the colour of good butter. They sell first in my window, every time."
          }
        }
      }
    },
    "notes.okafor.custard" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spring, and every basket is full. I am making custard tarts this week."
          }
        }
      }
    },
    "notes.okafor.green" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Green eggs in Featherwick. The children at my counter will not believe me."
          }
        }
      }
    },
    "notes.okafor.laying" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Word reached the bakery that your flock is laying. Fresh eggs make the best bread."
          }
        }
      }
    },
    "notes.okafor.olive" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Olive eggs. My grandmother kept a hen that laid them. You have brought back a memory."
          }
        }
      }
    },
    "notes.okafor.white" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A white egg, plain and clean. Good for meringue, and for painting at Easter."
          }
        }
      }
    },
    "notes.okafor.window" : {
      "comment" : "A note in the post from Mr Okafor. The placeholder is the egg colours (\"cream, blue and brown\") or \"fine\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "My window has %@ eggs this week, thanks to you. There is room for more colours."
          }
        }
      }
    },
    "notes.okafor.winterOven" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In winter the eggs come slower and the oven stays on longer. We manage."
          }
        }
      }
    },
    "notes.plateOfEggs" : {
