      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You had a visitor chicken! Can I say hello next time?"
          }
        }
      }
    },
    "notes.teddy.whichEgg" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do chickens know which egg is theirs? I think they do. I asked Mum and she doesn't know."
          }
        }
      }
    },
    "notes.wren.bigIncubator" : {
      "comment" : "A note in the post from Wren.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The big incubator is in at the shop. It holds a good many more eggs than a small one."
          }
        }
      }
    },
    "notes.wren.breedBook" : {
      "comment" : "A note in the post from Wren. The placeholder is the pages in the Breed Book (more than 1).",
