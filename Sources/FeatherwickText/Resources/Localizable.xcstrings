    "notes.teddy.chickNames" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can I name a chick one day? I have a list! Number one is Captain Fluff."
          }
        }
      }
    },
    "notes.teddy.counted" : {
