    "notes.wren.hazelNews" : {
      "comment" : "A note in the post from Wren. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ was in for twine. She says your flock is coming on nicely."
          }
        }
      }
    },
    "notes.wren.heat" : {
      "comment" : "A note in the post from Wren.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hot days ahead. A dish of water in the shade keeps a flock content."
          }
        }
      }
    },
    "notes.wren.leaves" : {
      "comment" : "A note in the post from Wren.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The leaves are coming down. Chickens love to scratch through them for beetles."
          }
        }
