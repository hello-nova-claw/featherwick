    "lore.leghorn.bredFor" : {
      "comment" : "Breed Book, Leghorn: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Eggs. The early Italian birds were small, laid well and needed little feed. White Leghorns became the main breed behind commercial white-egg layers."
          }
        }
      }
    },
    "lore.leghorn.eggs" : {
      "comment" : "Breed Book, Leghorn: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "White, about 280 a year from a good hen."
          }
        }
      }
    },
    "lore.leghorn.judge" : {
      "comment" : "Breed Book, Leghorn: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A slim, upright, streamlined body with the tail held high, and clean white feathers with no cream or yellow tint."
          }
        }
      }
    },
    "lore.leghorn.oddity" : {
      "comment" : "Breed Book, Leghorn: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Leghorn is the old English name for Livorno. In America, the first white birds were sold as Italian fowls."
          }
        }
      }
    },
    "lore.leghorn.origin" : {
      "comment" : "Breed Book, Leghorn: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From Tuscany in Italy. Ships took the birds to America from the port of Livorno in the 19th century."
          }
        }
      }
    },
    "lore.leghorn.temperament" : {
      "comment" : "Breed Book, Leghorn: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Very active and easily startled."
          }
        }
      }
    },
    "lore.marans.bredFor" : {
      "comment" : "Breed Book, Marans: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A farm bird for eggs and the table. Breeders crossed the local marsh fowl with Langshans."
          }
        }
      }
    },
    "lore.marans.eggs" : {
      "comment" : "Breed Book, Marans: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Very dark brown, from mahogany to chocolate."
          }
        }
      }
    },
    "lore.marans.judge" : {
      "comment" : "Breed Book, Marans: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A sturdy, active farm bird of good size, and a clean, even colour, such as black."
          }
        }
      }
    },
    "lore.marans.oddity" : {
      "comment" : "Breed Book, Marans: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The hen adds the dark brown last, in the final hours before the egg is laid. The breed nearly died out in the 1940s, and French breeders brought it back."
          }
        }
      }
    },
    "lore.marans.origin" : {
      "comment" : "Breed Book, Marans: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From the marshes around the port town of Marans in western France. It took its modern form in the early 20th century."
          }
        }
      }
    },
    "lore.marans.temperament" : {
      "comment" : "Breed Book, Marans: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Calm and easy-going."
          }
        }
      }
    },
    "lore.orpington.bredFor" : {
      "comment" : "Breed Book, Orpington: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A hardy farm bird, good for both eggs and the table."
          }
        }
      }
    },
    "lore.orpington.eggs" : {
      "comment" : "Breed Book, Orpington: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Light to medium brown."
          }
        }
      }
    },
    "lore.orpington.judge" : {
      "comment" : "Breed Book, Orpington: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A deep, broad, heavy body with a curved back and a low stance, full but smooth feathers, and an even colour."
          }
        }
      }
    },
    "lore.orpington.oddity" : {
      "comment" : "Breed Book, Orpington: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cook was a coachman. His first Orpingtons were black; buff, white and blue came later. Within ten years the breed was sent to other countries."
          }
        }
      }
    },
    "lore.orpington.origin" : {
      "comment" : "Breed Book, Orpington: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made in the town of Orpington in Kent, England, by William Cook, who showed it in 1886."
          }
        }
      }
    },
    "lore.orpington.temperament" : {
      "comment" : "Breed Book, Orpington: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Calm, docile and easy to handle. The hens often go broody."
          }
        }
      }
    },
    "lore.plymouthRock.bredFor" : {
      "comment" : "Breed Book, Plymouth Rock: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A farm bird for both eggs and meat."
          }
        }
      }
    },
    "lore.plymouthRock.eggs" : {
      "comment" : "Breed Book, Plymouth Rock: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brown, and plenty of them."
          }
        }
      }
    },
    "lore.plymouthRock.judge" : {
      "comment" : "Breed Book, Plymouth Rock: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A long, broad back and a deep, full breast. On barred birds, the black and white bars should be crisp, straight and even."
          }
        }
      }
    },
    "lore.plymouthRock.oddity" : {
      "comment" : "Breed Book, Plymouth Rock: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Barred was the first colour. Until the Second World War it was the most common farm chicken in the United States, and in the 1920s it helped to found the broiler industry."
          }
        }
      }
    },
    "lore.plymouthRock.origin" : {
      "comment" : "Breed Book, Plymouth Rock: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From Massachusetts, in the United States: made in the 1860s, and in the American standard by 1874."
          }
        }
      }
    },
    "lore.plymouthRock.temperament" : {
      "comment" : "Breed Book, Plymouth Rock: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Docile, hardy and easy to keep."
          }
        }
      }
    },
    "lore.silkie.bredFor" : {
      "comment" : "Breed Book, Silkie: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gentle company, and sitting: keepers set other birds' eggs under Silkie hens to hatch."
          }
        }
      }
    },
    "lore.silkie.eggs" : {
      "comment" : "Breed Book, Silkie: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Small cream or tinted eggs, about three a week."
          }
        }
      }
    },
    "lore.silkie.judge" : {
      "comment" : "Breed Book, Silkie: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A broad, stout body with a short back that rises to a short, round, fluffy tail, and soft fluff of one clear, even colour."
          }
        }
      }
    },
    "lore.silkie.oddity" : {
      "comment" : "Breed Book, Silkie: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Its feathers do not lock together, so they feel like fur. Under them, the skin and bones are black, and each foot has five toes."
          }
        }
      }
    },
    "lore.silkie.origin" : {
      "comment" : "Breed Book, Silkie: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An old breed from China, written about by Western travellers as early as the 13th century."
          }
        }
      }
    },
    "lore.silkie.temperament" : {
      "comment" : "Breed Book, Silkie: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "One of the calmest and most docile breeds there is."
          }
        }
      }
    },
    "lore.wyandotte.bredFor" : {
      "comment" : "Breed Book, Wyandotte: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A dual-purpose farm bird: a steady layer and a good table bird."
          }
        }
      }
    },
    "lore.wyandotte.eggs" : {
      "comment" : "Breed Book, Wyandotte: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Light to rich brown, about 150 to 200 a year."
          }
        }
      }
    },
    "lore.wyandotte.judge" : {
      "comment" : "Breed Book, Wyandotte: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A medium-sized bird with a round, curved body, and an even colour. On laced birds, each feather has a clean, even edge."
          }
        }
      }
    },
    "lore.wyandotte.oddity" : {
      "comment" : "Breed Book, Wyandotte: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The first birds were called American Sebrights. The silver laced birds came first, and joined the American standard in 1883."
          }
        }
      }
    },
    "lore.wyandotte.origin" : {
      "comment" : "Breed Book, Wyandotte: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made in New York State, in the United States, in the 1870s."
          }
        }
      }
    },
    "lore.wyandotte.temperament" : {
      "comment" : "Breed Book, Wyandotte: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mostly calm and friendly, though some birds like to be in charge of the flock."
          }
        }
      }
    },
