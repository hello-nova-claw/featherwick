    "village.about.bea" : {
      "comment" : "Who Bea is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bea runs the hen rescue on the hill. Every bird she takes in finds a good garden."
          }
        }
      }
    },
    "village.about.dot" : {
      "comment" : "Who Dot is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dot judges the county show. She has a sharp eye and a soft spot for a well-kept bird."
          }
        }
      }
    },
    "village.about.okafor" : {
      "comment" : "Who Mr Okafor is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mr Okafor bakes the village bread and fills his window with eggs of every colour."
          }
        }
      }
    },
    "village.about.teddy" : {
      "comment" : "Who Teddy is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Teddy lives down the lane. He isn't allowed a chicken, so he visits yours."
          }
        }
      }
    },
