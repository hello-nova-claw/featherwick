    "lore.araucana.bredFor" : {
      "comment" : "Breed Book, Araucana: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Its blue eggs, which very few breeds lay. Breeders joined two local fowl: one laid blue eggs and had no tail, and the other had ear tufts."
          }
        }
      }
    },
    "lore.araucana.eggs" : {
      "comment" : "Breed Book, Araucana: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Blue."
          }
        }
      }
    },
    "lore.araucana.judge" : {
      "comment" : "Breed Book, Araucana: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A light, lively bird of the size its standard asks for, and a clean, even colour, such as black."
          }
        }
      }
    },
    "lore.araucana.oddity" : {
      "comment" : "Breed Book, Araucana: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Many Araucanas have no tail at all, and some grow tufts of feathers beside their ears. Not every bird shows them."
          }
        }
      }
    },
    "lore.araucana.origin" : {
      "comment" : "Breed Book, Araucana: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "From the Araucanía region of Chile, where the breed took shape in the 20th century from fowl kept by the Mapuche people."
          }
        }
      }
    },
    "lore.araucana.temperament" : {
      "comment" : "Breed Book, Araucana: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Active, alert and curious. A keen forager."
          }
        }
      }
    },
    "lore.australorp.bredFor" : {
      "comment" : "Breed Book, Australorp: what keepers bred it for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Eggs. Australian breeders kept the Orpington's size and bred for more eggs and less broodiness."
          }
        }
      }
    },
    "lore.australorp.eggs" : {
      "comment" : "Breed Book, Australorp: the eggs real hens of the breed lay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Light to medium brown, often 250 or more a year."
          }
        }
      }
    },
    "lore.australorp.judge" : {
      "comment" : "Breed Book, Australorp: what a show judge looks for.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A deep, broad body with a full, rounded breast. Black birds should have a bright green sheen."
          }
        }
      }
    },
    "lore.australorp.oddity" : {
      "comment" : "Breed Book, Australorp: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The name joins Australian and Orpington. In the laying contests of the 1920s, Australorp hens set world records for the most eggs in a year. Orders for the birds soon came from England, the United States and other countries."
          }
        }
      }
    },
    "lore.australorp.origin" : {
      "comment" : "Breed Book, Australorp: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made in Australia in the early 20th century, from Black Orpingtons brought from England."
          }
        }
      }
    },
    "lore.australorp.temperament" : {
      "comment" : "Breed Book, Australorp: the breed's temperament.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Calm, gentle and friendly."
          }
        }
      }
    },
    "lore.foundOnDay" : {
      "comment" : "Breed Book: the first day a look of the breed was found. The placeholder is the day number.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
