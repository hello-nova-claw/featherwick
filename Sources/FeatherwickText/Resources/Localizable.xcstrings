    "notes.teddy.dreams" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Where do chickens sleep? Do they dream? I think they dream about worms."
          }
        }
      }
    },
    "notes.teddy.dustBath" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your chickens were rolling in the dirt! I thought they were broken! Gran says it's a bath."
          }
        }
      }
    },
    "notes.teddy.feather" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I found a feather by your gate! I'm keeping it in my best book."
          }
        }
      }
    },
    "notes.teddy.handFed" : {
