          }
        }
      }
    },
    "notes.teddy.lap" : {
      "comment" : "A note in the post from Teddy. The placeholder is the tamest bird's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ sat on my lap for AGES! Best day ever!"
          }
        }
      }
    },
    "notes.teddy.lap.general" : {
      "comment" : "A note in the post from Teddy, when what it names has gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A chicken sat on my lap for AGES! Best day ever!"
          }
        }
      }
    },
    "notes.teddy.ribbon" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You won a ribbon at the show! I told everyone at school!"
          }
        }
      }
    },
    "notes.teddy.snow" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It snowed! Do chickens get cold feet? I drew them a picture of the sun."
          }
        }
      }
    },
    "notes.teddy.visitor" : {
      "comment" : "A note in the post from Teddy. Placeholders: a loaned bird's name, twice.",
