    "notes.teddy.dreams" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Where do chickens sleep? Do they dream? I think they dream about worms."
          }
        }
      }
    },
    "notes.teddy.dustBath" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your chickens were rolling in the dirt! I thought they were broken! Gran says it's a bath."
          }
        }
      }
    },
    "notes.teddy.feather" : {
      "comment" : "A note in the post from Teddy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I found a feather by your gate! I'm keeping it in my best book."
          }
        }
      }
    },
    "notes.teddy.handFed" : {
      "comment" : "A note in the post from Teddy. The placeholder is the tamest bird's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ ate from my hand today! It tickled! Mum says I can come back on Saturday."
          }
        }
      }
    },
    "notes.teddy.handFed.general" : {
      "comment" : "A note in the post from Teddy, when what it names has gone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
