    "calendar.refusal.alreadyGiven" : {
      "comment" : "The Hatch-along can't take an egg: one is given this year. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You've brought your Hatch-along egg this year. One each, %@ says. There's next spring."
          }
        }
      }
    },
    "calendar.refusal.noFertileEgg" : {
      "comment" : "The Hatch-along can't take an egg: none is known fertile.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Hatch-along needs an egg you KNOW is fertile. Candle your eggs to find one, or buy a fertile egg at Speckle & Down: they come candled."
          }
        }
      }
    },
    "calendar.refusal.notThisWeek" : {
      "comment" : "The Hatch-along can't take an egg: it is not its week.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Hatch-along is in spring. Bring an egg in its week: the village calendar says when."
          }
        }
      }
    },
    "calendar.scene.hatchAlong.first" : {
      "comment" : "The first Hatch-along. The placeholders are Hazel's name and the nights until the chick comes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has her big incubator set up in the village hall. \"Everyone brings one egg they know is fertile, and everyone gets a chick back in %2$lld nights. Not your own egg's chick, mind: whichever the hatch sends you. That's the fun of it. You've all week.\""
          }
        }
      }
    },
    "calendar.scene.hatchAlong.later" : {
      "comment" : "A later Hatch-along. The placeholders are Hazel's name and the nights until the chick comes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Hatch-along again. %1$@'s incubator hums in the village hall, and the children have drawn name cards for the trays. One known-fertile egg this week, and a surprise chick comes home %2$lld nights later."
          }
        }
      }
    },
    "calendar.scene.longestDay.first" : {
      "comment" : "The first Longest Day. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The longest day of the year. The whole village is out on the green until the light goes. \"The fox never stirs tonight,\" %@ says. \"Too many people about. Leave the door open if you like: they can forage in peace.\""
          }
        }
      }
    },
    "calendar.scene.longestDay.later" : {
      "comment" : "A later Longest Day.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Midsummer again. The lanes smell of elderflower, and the fox keeps to its den tonight. A safe night to leave the door open, if you like."
          }
        }
      }
    },
    "calendar.scene.midwinterLights.first" : {
      "comment" : "The first Midwinter Lights. The placeholder is Wren's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Midwinter Lights. There's a lantern in every window down the lane, and %@ hangs a paper star over the shop door. The village keeps a little fund for its keepers, and this year you're one of them."
          }
        }
      }
    },
    "calendar.scene.midwinterLights.later" : {
      "comment" : "A later Midwinter Lights.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Midwinter Lights again. You know the way to the green now. The lanterns are lit, the kettle's on in the hall, and the keepers' fund comes round."
          }
        }
      }
    },
    "calendar.scene.moultWeek.first" : {
      "comment" : "The first Moult Week. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ leans on the fence. \"Don't fret if the coop looks like a pillow burst. It's the moult. Every autumn they drop their old feathers and grow new ones. They look a fright for a week or two, but nobody's poorly, and the judges know what season it is. Feathers are nearly all protein, so here: these help.\""
          }
        }
      }
    },
    "calendar.scene.moultWeek.later" : {
      "comment" : "A later Moult Week. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Moult Week again. Feathers drift round the yard like snow. %@ passes a bag over the fence. \"Same as last year, love. Protein in, new coats out.\""
          }
        }
      }
    },
    "cli.heading" : {
