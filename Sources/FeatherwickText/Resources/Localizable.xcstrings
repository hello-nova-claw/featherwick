{
  "sourceLanguage" : "en",
  "strings" : {
    "calendar.chicksComing.one" : {
      "comment" : "Calendar: one Hatch-along chick on its way. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your Hatch-along chick is coming from %@'s."
          }
        }
      }
    },
    "calendar.chicksComing.other" : {
      "comment" : "Calendar: Hatch-along chicks on their way, a number other than 1. The placeholders are the number of chicks and Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld Hatch-along chicks are coming from %2$@'s, one as each finds room."
          }
        }
      }
    },
    "calendar.effect.hatchAlong" : {
      "comment" : "Calendar: what the Hatch-along does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bring an egg you know is fertile in its week, and a surprise chick comes back."
          }
        }
      }
    },
    "calendar.effect.longestDay" : {
      "comment" : "Calendar: what the Longest Day does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The fox stays home that night."
          }
        }
      }
    },
    "calendar.effect.midwinterLights" : {
      "comment" : "Calendar: what Midwinter Lights does.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The village gives its keepers a gift."
          }
        }
      }
    },
    "calendar.effect.moultWeek" : {
      "comment" : "Calendar: what Moult Week does. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ brings mealworms for the moult."
          }
        }
      }
    },
    "calendar.gift.coins" : {
      "comment" : "A village day's gift. The placeholder is the coins.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The village gives you %lld coins."
          }
        }
      }
    },
    "calendar.gift.coinsAndMealworms" : {
      "comment" : "A village day's gift. The placeholders are the coins and the mealworms.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The village gives you %1$lld coins and %2$lld mealworms."
          }
        }
      }
    },
    "calendar.gift.mealworms" : {
      "comment" : "A village day's gift. The placeholder is the mealworms.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The village gives you %lld mealworms."
          }
        }
      }
    },
    "calendar.hatchAlong" : {
      "comment" : "A village day's short name: the spring egg swap.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hatch-along"
          }
        }
      }
    },
    "calendar.hatchAlongChickArrived" : {
      "comment" : "The Hatch-along chick comes home. The placeholders are Hazel's name and the chick's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ brings a chick home from the village hatch, cupped in her hands, and settles it under the heat lamp. What breed is it? You'll see when its feathers come in. %2$@ needs a name."
          }
        }
      }
    },
    "calendar.hatchAlongChickWaiting" : {
      "comment" : "The Hatch-along chick waits with Hazel. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ calls over the fence. \"Your Hatch-along chick is ready, but there's no room for it yet. It needs a place in the brooder, and a perch for when it's grown. It can stay with me until then. No hurry.\""
          }
        }
      }
    },
    "calendar.hatchAlongEggGiven" : {
      "comment" : "The keeper brings a Hatch-along egg. The placeholders are Hazel's name and the nights until the chick comes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You hand %1$@ an egg you know is fertile. She pencils your name on the tray and tucks it in with the village's eggs. \"%2$lld nights, and a chick comes back to you.\""
          }
        }
      }
    },
    "calendar.hatchAlongWeek" : {
      "comment" : "Calendar: the Hatch-along week is on. The placeholder is Hazel's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's Hatch-along week. Bring %@ an egg you know is fertile."
          }
        }
      }
    },
    "calendar.hatchAlongWeekNoEgg" : {
      "comment" : "Calendar: the Hatch-along week is on, and no egg is known fertile.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's Hatch-along week. You need an egg you know is fertile to bring one."
          }
        }
      }
    },
    "calendar.lineWithEffect" : {
      "comment" : "Calendar: one village day. The placeholders are its date line and what the day does.",
