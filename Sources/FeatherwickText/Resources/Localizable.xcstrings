          }
        }
      }
    },
    "people.tour.yard" : {
      "comment" : "Day 1 tour: Hazel at the yard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your birds scratch about here in the day. Tap a bird to see it, and pick it up to make friends."
          }
        }
      }
    },
    "people.tour.yardTitle" : {
