      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A blue egg, I hear. There is a space in my window for one, if you ever have a spare."
          }
        }
      }
    },
    "notes.okafor.brown" : {
      "comment" : "A note in the post from Mr Okafor.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brown eggs, warm as toast. The colour is only on the outside, but I like it all the same."
