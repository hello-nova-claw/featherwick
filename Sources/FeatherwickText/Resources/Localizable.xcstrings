    "story.broodySilkie.sitting" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Silkie settles onto your eggs with a happy grumble. Check back in a few days."
          }
        }
      }
    },
    "story.broodySilkie.start" : {
      "comment" : "Hazel's broody Silkie story. \"give eggs\" is the CLI command the player types.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel leans over the fence, laughing. \"My old Silkie has gone broody again. She's sitting on a golf ball! My mother hatched her whole lavender line under Silkies, you know. If you could spare 3 eggs you know are fertile, she'd hatch them for you.\" (Candle your eggs, then: give eggs)"
          }
        }
      }
    },
    "story.heritageBreed.settling" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Australorp hen is settling in. Give her a few days to find her feet."
          }
        }
      }
    },
    "story.heritageBreed.start" : {
      "comment" : "The heritage Australorp story. \"give eggs\" is the CLI command the player types.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A travelling keeper is retiring her heritage Australorp line. \"They're grand layers, gentle as anything. Bring me 4 eggs you know are fertile, so I know they'll be in good hands.\" Hazel nods. \"My mother found homes for her lavender birds the same way, when she retired.\" (candle, then: give eggs)"
          }
        }
      }
    },
    "story.lacedGift.start" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Wyandotte keeper two doors down stops to admire your flock over the fence. \"You've a proper little henhaven going. Give me a few days — I've a girl who'd be happier with you.\" Hazel smiles. \"That's how my mother's lavender line began: one hen, handed over a fence.\""
          }
        }
      }
    },
    "story.marigold.decide" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel is home, and at the fence first thing. \"Has Marigold been good? She can come home with me, and I'll give you an egg from my flock to hatch. Or keep her, if you like. Pay me when you can.\""
          }
        }
      }
    },
    "story.marigold.start" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel leans over the fence. \"I'm off to my sister's soon, for a few days. Could Marigold stay with you while I'm gone? She's your chick's mother, and a good layer. She brings her own box.\""
          }
        }
      }
    },
    "story.marigold.staying" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel lifts Marigold over the fence, box and all. \"Her eggs are yours. Shut the door at night. I'll be back before you know it!\""
          }
        }
      }
    },
    "story.unknown" : {
