    "villagePeople.standard.araucana" : {
      "comment" : "Dot's notes on the Araucana, from the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A neat crest that never hides the eyes, and a small pea comb. A lively, upright bird, with the tail carried well. And the eggs must be blue."
          }
        }
      }
    },
    "villagePeople.standard.australorp" : {
      "comment" : "Dot's notes on the Australorp, from the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Upright and busy, with a deep body and a bright red single comb. Dark eyes. In the right light, the black feathers shine beetle-green."
          }
        }
      }
    },
    "villagePeople.standard.orpington" : {
      "comment" : "Dot's notes on the Orpington, from the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A big, soft, deep bird, low to the ground. A short back and a smooth curve from neck to tail. Plenty of loose feather, and a neat single comb that stands up straight."
          }
        }
      }
    },
    "villagePeople.standard.silkie" : {
      "comment" : "Dot's notes on the Silkie, from the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fluff all over, like a powder puff. A round crest, a walnut comb, feathered feet and five toes. Dark skin and face, and turquoise earlobes."
          }
        }
      }
    },
    "villagePeople.standard.wyandotte" : {
      "comment" : "Dot's notes on the Wyandotte, from the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Curves everywhere: a round body, a short back and a full breast. A rose comb, low and tight. On a laced bird, a clean, even edge on every feather."
          }
        }
      }
    },
