    "villagePeople.note.beaInvite" : {
      "comment" : "Bea's invitation. The placeholder is a rehomed bird's name, or \"your bird\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Come up to the rescue one afternoon and see %@ for yourself. I'll put the kettle on. No need to write first. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard" : {
      "comment" : "Bea's postcard. The placeholder is a rehomed bird's name, or \"your bird\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dear keeper, I've been to see %@, who went to a new home from Henhaven. Happy as anything, with a favourite corner of the run, and the children say good morning every day. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard3" : {
      "comment" : "Bea's third postcard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Three of your birds have new homes in Featherwick now. The newest one settled in at once. You raise them kind, keeper. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard3Named" : {
