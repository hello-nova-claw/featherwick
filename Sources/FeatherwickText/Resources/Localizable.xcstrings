    },
    "people.welcome.askName" : {
      "comment" : "Day 1: Hazel asks the keeper's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What do I call you?"
