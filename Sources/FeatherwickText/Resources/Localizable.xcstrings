      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It snowed! Do chickens get cold feet? I drew them a picture of the sun."
          }
        }
      }
    },
    "notes.teddy.visitor" : {
