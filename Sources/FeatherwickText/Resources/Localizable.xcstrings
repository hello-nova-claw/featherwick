      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Olive eggs. My grandmother kept a hen that laid them. You have brought back a memory."
          }
        }
      }
    },
    "notes.okafor.white" : {
