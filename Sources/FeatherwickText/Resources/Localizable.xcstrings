    "people.chickOffer" : {
      "comment" : "Day 1: Hazel offers a chick. The placeholder is the keeper's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lovely to meet you, %@. My hens hatched a clutch yesterday. Take whichever chick you like."
          }
        }
      }
    },
    "people.neighbour" : {
      "comment" : "The neighbour's name, over the back fence.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel"
          }
        }
      }
    },
    "people.neighbourAbout" : {
      "comment" : "Who Hazel, the neighbour, is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hazel has kept hens over the back fence for forty years, and she has a story for every breed."
          }
        }
      }
    },
    "people.shopkeeper" : {
      "comment" : "The shop keeper's name, at Speckle & Down.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wren"
          }
        }
      }
    },
    "people.shopkeeperAbout" : {
      "comment" : "Who Wren, the shop keeper, is, in one line.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wren took over her gran's feed shop, Speckle & Down. She knows all the village news."
          }
        }
      }
    },
    "people.tour.backFence" : {
      "comment" : "Day 1 tour: Hazel at the back fence.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's my garden over the fence. Come to me for lessons and news. I'll leave you a note when there's something new."
          }
        }
      }
    },
    "people.tour.backFenceTitle" : {
      "comment" : "Day 1 tour: the third stop's title.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The back fence"
          }
        }
      }
    },
    "people.tour.coop" : {
      "comment" : "Day 1 tour: Hazel at the coop. The placeholder is the chick's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ sleeps in the brooder here, under the heat lamp. Grown birds get a perch. Feed the flock every day and collect the eggs."
          }
        }
      }
    },
    "people.tour.coopNoChick" : {
      "comment" : "Day 1 tour: Hazel at the coop, before a chick is chosen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "your chick sleeps in the brooder here, under the heat lamp. Grown birds get a perch. Feed the flock every day and collect the eggs."
          }
        }
      }
    },
    "people.tour.coopTitle" : {
      "comment" : "Day 1 tour: the first stop's title.",
      "extractionState" : "extracted_with_value",
