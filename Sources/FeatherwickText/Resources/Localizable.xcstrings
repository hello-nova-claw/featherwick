      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %@ favours the breed classes. Type and colour count most."
          }
        }
      }
    },
    "notes.dot.lapChicken" : {
      "comment" : "A note in the post from Dot.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
