    "villagePeople.needEggsOfNewColour" : {
      "comment" : "Refused: not enough eggs of a new colour. Placeholders: the eggs needed, the colours (\"blue or green\"), the most eggs of one of those colours the keeper has.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That needs %1$lld eggs of one new colour in your carton: %2$@. You have %3$lld of the colour you have most of. No hurry: Mr Okafor will wait."
          }
        }
      }
    },
    "villagePeople.note.beaInvite" : {
      "comment" : "Bea's invitation. The placeholder is a rehomed bird's name, or \"your bird\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Come up to the rescue one afternoon and see %@ for yourself. I'll put the kettle on. No need to write first. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard" : {
      "comment" : "Bea's postcard. The placeholder is a rehomed bird's name, or \"your bird\".",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dear keeper, I've been to see %@, who went to a new home from Henhaven. Happy as anything, with a favourite corner of the run, and the children say good morning every day. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard3" : {
      "comment" : "Bea's third postcard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Three of your birds have new homes in Featherwick now. The newest one settled in at once. You raise them kind, keeper. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.beaPostcard3Named" : {
      "comment" : "Bea's third postcard. The placeholder is the newest rehomed bird's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Three of your birds have new homes in Featherwick now. %@ is the newest, and settled in at once. You raise them kind, keeper. Love, Bea."
          }
        }
      }
    },
    "villagePeople.note.okaforMarketBoard" : {
      "comment" : "Mr Okafor's note about the market board.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There's talk of a market board by the bakery, where keepers can say what they have. I've put your name down first, if you'll have it."
          }
        }
      }
    },
    "villagePeople.note.okaforWindow" : {
      "comment" : "Mr Okafor's note. Henhaven is the keeper's farm.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your eggs sit in the middle of my window, and people come in just to ask about them. Since you waited, I've put a card by them with Henhaven's name on it."
          }
        }
      }
    },
    "villagePeople.note.standard" : {
      "comment" : "Dot's note. Placeholders: the breed's name, her notes on it, the breed's name again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Here is the %1$@ page, with my pencil notes in the margin. \"%2$@\" (Dot's notes are in your Breed Book now, on the %3$@ page.)"
          }
        }
      }
    },
    "villagePeople.note.teddyDrawing" : {
      "comment" : "Teddy's drawing comes in the post.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A drawing in crayon of every bird in your flock, with the names spelled Teddy's own way. You pin it to the coop door."
          }
        }
      }
    },
    "villagePeople.note.teddyLap" : {
      "comment" : "Teddy sees a lap chicken. The placeholder is the bird's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"That one's a lap chicken, you know,\" Teddy says, pointing at %@. He looks very proud."
          }
        }
      }
    },
    "villagePeople.note.teddyLapNamed" : {
      "comment" : "Teddy sees a lap chicken. He named one of the keeper's chicks. The placeholder is the bird's name.",
