    "people.tour.farmGate" : {
      "comment" : "Day 1 tour: Hazel at the farm gate. The placeholder is Wren's about line (people.shopkeeperAbout).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The lane goes down to Speckle & Down. %@ She's only got feed in for now, but she'll have more soon."
          }
        }
      }
    },
    "people.tour.farmGateTitle" : {
      "comment" : "Day 1 tour: the last stop's title.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
