          "stringUnit" : {
            "state" : "new",
            "value" : "What the judge looks for"
          }
        }
      }
    },
    "lore.heading.oddity" : {
      "comment" : "Breed Book lore page heading: one true, odd fact.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Did you know?"
          }
        }
      }
    },
    "lore.heading.origin" : {
      "comment" : "Breed Book lore page heading: where and when the breed was made.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
