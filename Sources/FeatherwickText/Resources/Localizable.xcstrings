    },
    "notes.wren.frost" : {
      "comment" : "A note in the post from Wren.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Frost on the lane this morning. Everyone at the shop is in two jumpers."
          }
