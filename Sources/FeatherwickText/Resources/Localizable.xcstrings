    "people.welcome.hello" : {
      "comment" : "Day 1: Hazel says hello.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hello there! I'm Hazel, from over the back fence. You must be the new keeper at Henhaven."
