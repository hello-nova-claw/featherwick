{
  "sourceLanguage" : "en",
  "strings" : {
    "arc.bea.invite" : {
      "comment" : "Bea's story: her postcard comes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You pin Bea's postcard up by the coop door."
          }
        }
      }
    },
    "arc.bea.start" : {
      "comment" : "Bea's story starts. Henhaven is the keeper's farm.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "News travels in Featherwick. Bea, who runs the hen rescue on the hill, has heard about the bird that went to a new home from Henhaven."
          }
        }
      }
    },
    "arc.bea.third" : {
      "comment" : "Bea's story: her invitation comes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bea's invitation goes on the shelf by the door. The rescue is open whenever you like."
          }
        }
      }
    },
    "arc.dot.invite" : {
      "comment" : "Dot's story: she invites the keeper to see the breed standard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dot stops you in the lane. \"Come by on a quiet afternoon and I'll show you the standard. It's the book we judges score by. Every breed has its own page.\""
          }
        }
      }
    },
    "arc.dot.standard" : {
      "comment" : "Dot's story: she asks which breed's page to read.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dot opens a fat old book with a cracked spine. \"Which page shall we read first? One of your own breeds, I think.\""
          }
        }
      }
    },
    "arc.dot.start" : {
      "comment" : "Dot's story starts at the county show's entry desk.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the entry desk, a woman with reading glasses on a chain watches you fill in your form. \"First show? I'm Dot. I judge. Don't let that frighten you.\""
          }
        }
      }
    },
    "arc.dot.startVeteran" : {
      "comment" : "Dot's story starts, for a keeper who has shown birds before.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the entry desk, a woman with reading glasses on a chain looks up from her list. \"I've seen your birds at a show or two. I'm Dot. I judge. We should talk properly some time.\""
          }
        }
      }
    },
    "arc.okafor.board" : {
      "comment" : "Mr Okafor's story ends.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "People stop at the bakery window to look at your eggs. Mr Okafor says it's good for trade."
          }
        }
      }
    },
    "arc.okafor.bring" : {
      "comment" : "Mr Okafor's story: he waits for the eggs.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mr Okafor clears a space in his window. \"Bring them down to the bakery when they're ready.\""
          }
        }
      }
    },
    "arc.okafor.start" : {
      "comment" : "Mr Okafor's story starts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mr Okafor from the bakery stops at your gate, flour on his sleeves. \"Those brown eggs of yours! I've a basket in my shop window that wants filling.\""
          }
        }
      }
    },
    "arc.okafor.thanks" : {
      "comment" : "Mr Okafor's story: the eggs go in his window.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mr Okafor sets your eggs in his window one by one, and steps back to look."
          }
        }
      }
    },
    "arc.okafor.window" : {
      "comment" : "Mr Okafor's story: brown eggs now, or a new colour later.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mr Okafor is back. \"Six brown eggs would fill the basket now. But a colour nobody has seen in my window yet... I'd wait for that. It's your choice, and there's no hurry.\""
          }
        }
      }
    },
    "arc.teddy.help" : {
      "comment" : "Teddy's story: he offers two ways to help.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Teddy has his wellies on today. \"Can I help? I could name your next chick. I'm good at names. Or we could have a drawing day, and I'll draw all of them.\""
          }
        }
      }
    },
    "arc.teddy.lap" : {
      "comment" : "Teddy's story: he asks the keeper to make a lap chicken.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Teddy runs home happy. \"Pick them up lots,\" he calls back. \"Then one of them will be a lap chicken. I'll know when it happens.\""
          }
        }
      }
    },
    "arc.teddy.notAllowed" : {
      "comment" : "Teddy's story: he may not keep a chicken.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Teddy is back at the gate. \"Mum says I'm not allowed a chicken. Not even a small one. So I'm going to visit yours instead.\""
          }
        }
      }
    },
    "arc.teddy.start" : {
      "comment" : "Teddy's story starts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A boy with muddy knees hangs over your gate. \"Is that your chicken? Can I meet it? I'm Teddy. I live down the lane.\""
          }
        }
      }
    },
    "cli.heading" : {
