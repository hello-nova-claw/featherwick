      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Longest Day"
          }
        }
      }
    },
    "calendar.midwinterLights" : {
      "comment" : "A village day's short name: the winter festival.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Midwinter Lights"
          }
        }
      }
    },
    "calendar.midwinterNote.first" : {
      "comment" : "Teddy's first Midwinter note.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"Mum says I can't have a chicken but I can draw one. This is yours. The yellow bit is the lights.\" A crayon drawing of a very round bird under a very big moon."
          }
        }
      }
    },
    "calendar.midwinterNote.later" : {
      "comment" : "Teddy's later Midwinter notes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"I drew all of them this year. The one in the hat is you.\" A crayon drawing of a lot of birds, a coop, and someone in a hat."
          }
        }
      }
    },
    "calendar.moultGift.one" : {
      "comment" : "Moult Week: Hazel's gift, when treats == 1. The placeholders are the mealworms given and the treats now held.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You're given %1$lld mealworm. You have %2$lld treats."
          }
        }
      }
    },
    "calendar.moultGift.other" : {
      "comment" : "Moult Week: Hazel's gift, a number of mealworms other than 1. The placeholders are the mealworms given and the treats now held.",
