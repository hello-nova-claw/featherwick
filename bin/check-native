#!/usr/bin/env python3
"""Fails when the code reaches past what Apple, or the game's own tokens, already provide.

Checks what swift-format and SwiftLint cannot: hard-coded colours outside the
Design tokens, fixed system font sizes, print outside the CLI, and Swift
packages that are not on the allowlist below.
See "Use what Apple already has" in CONTRIBUTING.md.

Usage: bin/check-native [root]
"""

import re
import sys
from pathlib import Path

# Swift packages with no Apple equivalent. Adding one is a review decision: it
# happens in a pull request with a reason, a licence check and a notice.
ALLOWED_PACKAGES: list[str] = []

# Code that may build a colour by hand, and why. Each entry is a path and a
# piece of the line, so a new colour elsewhere in the same file still fails.
ALLOWED_COLOURS = [
    # Not a colour: the scene shader reads the channels as material and value.
    ("App/Featherwick/Scene/SeasonRamp.swift", "Color(red: value"),
    # The placeholder chicken's eye: a bird's own colour, not a UI colour.
    ("App/Featherwick/Scene/ChickenRig.swift", "var eye: Color = Color(white:"),
    # Flat stand-ins until the panel paintings exist (#77).
    ("App/Featherwick/Farm/FarmView.swift", "case .barn: Color(hex:"),
    ("App/Featherwick/Farm/FarmView.swift", "case .yard: Color(hex:"),
    ("App/Featherwick/Farm/FarmView.swift", "case .farYard: Color(hex:"),
    ("App/Featherwick/Farm/FarmView.swift", "case .shop: Color(hex:"),
    ("App/Featherwick/Farm/FarmView.swift", "Color(hex: 0x1B2233)"),
    ("App/Featherwick/Farm/FarmView.swift", ".shadow(color: Color(hex: 0x2A2320)"),
]

COLOUR = re.compile(r"\b(?:Color\((?:red|hex|white):|UIColor\((?:red|white|hue):|Color\(\s*\.sRGB)")
FIXED_FONT = re.compile(r"\.system\(size:")
PRINT = re.compile(r"(?<![\w.])print\(")
# Every way Package.swift can name a dependency: by URL, by path, or by registry id.
PACKAGE = re.compile(r'\.package\(\s*(?:name:\s*"[^"]*",\s*)?(?:url|path|id):\s*"([^"]+)"')
# XcodeGen's packages: section names the app's dependencies, one key per package. The local
# package (path: ..) is this repository and needs no entry.
PROJECT_PACKAGE = re.compile(r"^\s{4}(url|path|github):\s*(\S+)", re.MULTILINE)

DESIGN_TOKENS = "App/Featherwick/Design/"
TEST_DIRS = ("Tests/", "App/FeatherwickTests/", "App/FeatherwickUITests/")


def swift_files(root: Path, *dirs: str):
    for d in dirs:
        base = root / d
        if base.exists():
            yield from sorted(base.rglob("*.swift"))


def strip_swift_comments(text: str) -> str:
    """Removes // and /* */ comments from Swift source, keeping string literals (and the // in URLs)."""
    out, i, n = [], 0, len(text)
    while i < n:
        if text.startswith('"', i):
            end = i + 1
            while end < n and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            out.append(text[i : end + 1])
            i = end + 1
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            i = n if end == -1 else end + 2
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def strip_comment(line: str) -> str:
    return line.split("//", 1)[0]


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    errors = []

    for path in swift_files(root, "Sources", "App"):
        rel = path.relative_to(root).as_posix()
        is_test = rel.startswith(TEST_DIRS)
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            code = strip_comment(line)
            if COLOUR.search(code) and not rel.startswith(DESIGN_TOKENS) and not is_test:
                if not any(rel == p and piece in line for p, piece in ALLOWED_COLOURS):
                    errors.append(f"{rel}:{number}: a hard-coded colour. Use a Palette token from {DESIGN_TOKENS}.")
            if FIXED_FONT.search(code) and not is_test:
                errors.append(f"{rel}:{number}: a fixed font size. Use a Typeface token that scales with Dynamic Type.")
            if PRINT.search(code) and not rel.startswith("Sources/FeatherwickCLI/") and not is_test:
                errors.append(f"{rel}:{number}: print. Use os.Logger in the app; Core and Text never print.")

    manifest = root / "Package.swift"
    if manifest.exists():
        text = strip_swift_comments(manifest.read_text(encoding="utf-8"))
        # A dependency the pattern cannot read (a URL in a variable, say) fails rather than slips past.
        if len(re.findall(r"\.package\(", text)) != len(PACKAGE.findall(text)):
            errors.append("Package.swift: a .package(...) declaration names its source with something other than a string literal. Write the URL, path or id out in full.")
        for match in PACKAGE.finditer(text):
            if match.group(1) not in ALLOWED_PACKAGES:
                errors.append(f"Package.swift: {match.group(1)} is not on the allowlist in bin/check-native.")

    project = root / "App" / "project.yml"
    if project.exists():
        text = project.read_text(encoding="utf-8")
        section = re.search(r"^packages:\n((?:[ \t]+.*\n|\n)*)", text, re.MULTILINE)
        for kind, value in PROJECT_PACKAGE.findall(section.group(1) if section else ""):
            if kind == "path" and value.strip("\"'") == "..":
                continue
            if value not in ALLOWED_PACKAGES:
                errors.append(f"App/project.yml: package {value} is not on the allowlist in bin/check-native.")

    for error in errors:
        print(f"::error::{error}")
    if errors:
        print(f"{len(errors)} problem(s). See \"Use what Apple already has\" in CONTRIBUTING.md.")
        return 1
    print("No hard-coded colours, fixed font sizes, prints or unlisted packages.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
